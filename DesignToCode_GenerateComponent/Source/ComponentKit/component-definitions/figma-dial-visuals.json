  "nativeBoundary": {
    "source": "Qt 5.15.2 qdial.cpp (valueFromPoint / notchSize)",
    "url": "https://raw.githubusercontent.com/qt/qtbase/v5.15.2/src/widgets/widgets/qdial.cpp",
    "snapshot": "Original 270-degree Off / 360-degree On arcs, authored transforms, center (90,86), independent label 40. Inert gallery specimens only.",
    "interactive": "Native QDial handles input unchanged. Pointer, active arc and notches derive from native sliderPosition, range, wrapping and inversion. Off uses native 300-degree bottom-gap sweep; On starts at native bottom. Center follows widget midpoint. No mouse remapping.",
    "valueText": "Composition label, not a native QDial property. Null label follows sliderPosition; explicit text does not set value.",
    "notches": "Native notchSize is read-only, derived from notchTarget, singleStep, pageStep, range and widget size. Dynamic rendering thins dense intervals at whole multiples to at most 2049 marks.",
    "demoSafety": "Inspector range is bounded to +/-1000000, steps to 10000, notchTarget to 0.1..100. Wrapping inspector requires nonzero range to avoid Qt5.15.2 modulo-zero boundary. Helper does not change range or other native properties.",
    "inversion": "Qt5.15.2 mouse inversion uses maximum-bound(value); nonzero minimum can disagree with normalized visual inversion. Existing native behavior is retained, not silently patched.",
    "approval": "No design approval, normalization promotion or new public identity."
  }
}
