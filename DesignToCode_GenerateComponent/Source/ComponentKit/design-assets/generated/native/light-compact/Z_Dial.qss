/* Z_Dial <- QDial; compiled from the active Token profile. */
*[designSystemClass="commonWidget::Z_Dial"][designSystemStyleOwner="tokens"] {
    color: #191919;
    background-color: #ffffff;
    font-size: 14px;
}
*[designSystemClass="commonWidget::Z_Dial"][designSystemStyleOwner="tokens"]:disabled {
    color: #bbbbbb;
    background-color: #eeeeee;
    border-color: #d0d0d0;
}
*[designSystemClass="commonWidget::Z_Dial"][designSystemStyleOwner="tokens"] {
    min-height: 32px;
    border: 1px solid #a7a7a7;
    border-radius: 4px;
    padding-left: 8px;
    padding-right: 8px;
}
*[designSystemClass="commonWidget::Z_Dial"][designSystemStyleOwner="tokens"]:focus[focusIndicatorVisible="true"] { border-color: #6235f7; }
