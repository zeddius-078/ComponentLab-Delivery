/* Z_GraphicsView <- QGraphicsView; compiled from the active Token profile. */
*[designSystemClass="commonWidget::Z_GraphicsView"] {
    color: #191919;
    background-color: #ffffff;
    font-size: 14px;
}
*[designSystemClass="commonWidget::Z_GraphicsView"]:disabled {
    color: #bbbbbb;
    background-color: #eeeeee;
    border-color: #d0d0d0;
}
*[designSystemClass="commonWidget::Z_GraphicsView"] {
    border: 1px solid #a7a7a7;
    border-radius: 4px;
}
