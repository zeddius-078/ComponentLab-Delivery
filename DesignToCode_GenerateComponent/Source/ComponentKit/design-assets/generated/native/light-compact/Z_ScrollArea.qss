/* Z_ScrollArea <- QScrollArea; compiled from the active Token profile. */
*[designSystemClass="commonWidget::Z_ScrollArea"] {
    color: #191919;
    background-color: #ffffff;
    font-size: 14px;
}
*[designSystemClass="commonWidget::Z_ScrollArea"]:disabled {
    color: #bbbbbb;
    background-color: #eeeeee;
    border-color: #d0d0d0;
}
*[designSystemClass="commonWidget::Z_ScrollArea"] {
    border: 1px solid #a7a7a7;
    border-radius: 4px;
}
*[designSystemClass="commonWidget::Z_ScrollArea"][figmaSnapshotState="Focus"],
*[designSystemClass="commonWidget::Z_ScrollArea"]:focus[focusIndicatorVisible="true"] { border: 2px solid #6235f7; }
*[designSystemClass="commonWidget::Z_ScrollArea"] QWidget#qt_scrollarea_viewport { background-color: #ffffff; }
*[designSystemClass="commonWidget::Z_ScrollArea"]:disabled QWidget#qt_scrollarea_viewport { background-color: #eeeeee; }
*[designSystemClass="commonWidget::Z_ScrollAreaContent"] {
    background-color: #ffffff;
}
*[designSystemClass="commonWidget::Z_ScrollAreaContent"]:disabled {
    background-color: #eeeeee;
}
*[designSystemClass="commonWidget::Z_ScrollAreaContentSkeleton"] {
    background-color: #eeeeee;
    border: 0;
    border-radius: 4px;
}
*[designSystemClass="commonWidget::Z_ScrollAreaContentSkeleton"]:disabled {
    background-color: #d0d0d0;
}
