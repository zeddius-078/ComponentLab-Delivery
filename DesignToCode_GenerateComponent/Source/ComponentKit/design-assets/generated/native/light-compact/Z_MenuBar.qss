/* Z_MenuBar <- QMenuBar; compiled from the active Token profile. */
*[designSystemClass="commonWidget::Z_MenuBar"] {
    color: #191919;
    background-color: #ffffff;
    font-size: 14px;
}
*[designSystemClass="commonWidget::Z_MenuBar"]:disabled {
    color: #8a8a8a;
    background-color: #f3f3f3;
    border-color: #d0d0d0;
}
