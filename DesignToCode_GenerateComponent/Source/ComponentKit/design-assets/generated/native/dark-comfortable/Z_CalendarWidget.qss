/* Z_CalendarWidget <- QCalendarWidget; compiled from the active Token profile. */
*[designSystemClass="commonWidget::Z_CalendarWidget"][designSystemStyleOwner="tokens"] {
    color: #f3f3f3;
    background-color: #272727;
    font-size: 14px;
}
*[designSystemClass="commonWidget::Z_CalendarWidget"][designSystemStyleOwner="tokens"]:disabled {
    color: #8a8a8a;
    background-color: #303030;
    border-color: #444444;
}
*[designSystemClass="commonWidget::Z_CalendarWidget"][designSystemStyleOwner="tokens"] {
    border: 1px solid #676767;
    border-radius: 4px;
}
*[designSystemClass="commonWidget::Z_CalendarWidget"][designSystemStyleOwner="tokens"] QWidget#qt_calendar_navigationbar {
    background-color: #393939;
    border: 0;
    border-radius: 4px;
    min-height: 42px;
}
*[designSystemClass="commonWidget::Z_CalendarWidget"][designSystemStyleOwner="tokens"] QToolButton {
    color: #f3f3f3;
    background: transparent;
    border: 0;
    border-radius: 4px;
    min-width: 28px;
    min-height: 28px;
    font-weight: 600;
}
*[designSystemClass="commonWidget::Z_CalendarWidget"][designSystemStyleOwner="tokens"] QToolButton:hover { background-color: #272727; }
*[designSystemClass="commonWidget::Z_CalendarWidget"][designSystemStyleOwner="tokens"] QSpinBox {
    color: #f3f3f3;
    background: transparent;
    border: 0;
    selection-background-color: #6235f7;
}
*[designSystemClass="commonWidget::Z_CalendarWidget"][designSystemStyleOwner="tokens"] QAbstractItemView {
    color: #f3f3f3;
    background-color: #272727;
    border: 0;
    outline: 0;
    selection-background-color: #6235f7;
    selection-color: #ffffff;
}
*[designSystemClass="commonWidget::Z_CalendarWidget"][designSystemStyleOwner="tokens"] QAbstractItemView::item:selected {
    background-color: #6235f7;
    color: #ffffff;
    border-radius: 4px;
}
*[designSystemClass="commonWidget::Z_CalendarWidget"][designSystemStyleOwner="tokens"] QAbstractItemView:disabled {
    color: #8a8a8a;
    background-color: #303030;
    selection-background-color: #444444;
    selection-color: #8a8a8a;
}
*[designSystemClass="commonWidget::Z_CalendarWidget"][designSystemStyleOwner="tokens"] QAbstractItemView:disabled::item:selected {
    background-color: #444444;
    color: #8a8a8a;
}
*[designSystemClass="commonWidget::Z_CalendarWidget"][designSystemStyleOwner="tokens"][figmaSnapshotState="Disabled"] QWidget#qt_calendar_navigationbar {
    background-color: #303030;
}
