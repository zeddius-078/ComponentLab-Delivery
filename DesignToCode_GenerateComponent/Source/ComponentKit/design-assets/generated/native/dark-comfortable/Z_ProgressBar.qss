/* Z_ProgressBar <- QProgressBar; compiled from the active Token profile. */
*[designSystemClass="commonWidget::Z_ProgressBar"] {
    color: #f3f3f3;
    background-color: #272727;
    font-size: 14px;
}
*[designSystemClass="commonWidget::Z_ProgressBar"]:disabled {
    color: #8a8a8a;
    background-color: #303030;
    border-color: #444444;
}
*[designSystemClass="commonWidget::Z_ProgressBar"] {
    min-height: 32px;
    border: 1px solid #676767;
    border-radius: 4px;
    text-align: center;
}
*[designSystemClass="commonWidget::Z_ProgressBar"]::chunk { background-color: #6235f7; border-radius: 4px; }
