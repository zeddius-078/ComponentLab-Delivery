/* Z_FontDialog <- QFontDialog; compiled from the active Token profile. */
*[designSystemClass="commonWidget::Z_FontDialog"] {
    color: #f3f3f3;
    background-color: #272727;
    font-size: 14px;
}
*[designSystemClass="commonWidget::Z_FontDialog"]:disabled {
    color: #8a8a8a;
    background-color: #303030;
    border-color: #444444;
}
