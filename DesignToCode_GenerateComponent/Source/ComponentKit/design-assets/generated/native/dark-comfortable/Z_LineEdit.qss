/* Z_LineEdit <- QLineEdit; compiled from the active Token profile. */
*[designSystemClass="commonWidget::Z_LineEdit"] {
    color: #f3f3f3;
    background-color: #272727;
    font-size: 14px;
}
*[designSystemClass="commonWidget::Z_LineEdit"]:disabled {
    color: #8a8a8a;
    background-color: #303030;
    border-color: #444444;
}
*[designSystemClass="commonWidget::Z_LineEdit"] {
    min-height: 32px;
    border: 1px solid #676767;
    border-radius: 4px;
    padding-left: 8px;
    padding-right: 8px;
}
*[designSystemClass="commonWidget::Z_LineEdit"]:focus { border-color: #6235f7; }
