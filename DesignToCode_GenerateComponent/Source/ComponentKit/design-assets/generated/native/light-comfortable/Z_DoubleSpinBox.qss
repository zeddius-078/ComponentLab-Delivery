/* Z_DoubleSpinBox <- QDoubleSpinBox; compiled from the active Token profile. */
*[designSystemClass="commonWidget::Z_DoubleSpinBox"] {
    color: #191919;
    background-color: #ffffff;
    font-size: 14px;
}
*[designSystemClass="commonWidget::Z_DoubleSpinBox"]:disabled {
    color: #8a8a8a;
    background-color: #f3f3f3;
    border-color: #d0d0d0;
}
*[designSystemClass="commonWidget::Z_DoubleSpinBox"] {
    min-height: 32px;
    border: 1px solid #a7a7a7;
    border-radius: 4px;
    padding-left: 8px;
    padding-right: 8px;
}
*[designSystemClass="commonWidget::Z_DoubleSpinBox"]:focus { border-color: #6235f7; }
