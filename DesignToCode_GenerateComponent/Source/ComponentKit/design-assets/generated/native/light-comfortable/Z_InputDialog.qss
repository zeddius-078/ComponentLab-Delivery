/* Z_InputDialog <- QInputDialog; compiled from the active Token profile. */
*[designSystemClass="commonWidget::Z_InputDialog"] {
    color: #191919;
    background-color: #ffffff;
    font-size: 14px;
}
*[designSystemClass="commonWidget::Z_InputDialog"]:disabled {
    color: #bbbbbb;
    background-color: #eeeeee;
    border-color: #d0d0d0;
}
