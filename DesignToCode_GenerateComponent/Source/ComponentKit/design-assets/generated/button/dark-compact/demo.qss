/* GENERATED DEMO SHELL | bdc3e50ba3578d10916d4f62e0c7610062200b228553706588aa86283919c3d8 */
QMainWindow, QDialog { background: #191919; }
QWidget { color: #f3f3f3; font-family: 'HarmonyOS Sans SC'; font-size: 14px; }
QLineEdit, QComboBox, QTreeWidget, QTableWidget, QPlainTextEdit { background: #272727; color: #f3f3f3; selection-background-color: #6235f7; selection-color: #ffffff; }
QGroupBox { border: 1px solid #676767; border-radius: 4px; padding-top: 14px; }
QGroupBox::title { subcontrol-origin: margin; left: 8px; }
QWidget#previewHost { background: #272727; }
QWidget#previewHost[ghostSurface="true"], QWidget#ghostSampleHost { background: #6235f7; }
QLabel#titleLabel { font-size: 20px; font-weight: 600; }
QLineEdit, QComboBox, QCheckBox, QRadioButton, QToolButton { min-height: 32px; }
