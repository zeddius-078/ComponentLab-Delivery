/* GENERATED DEMO SHELL | e35b1f706bbffcc0447194bcddf9631373de3b8e6cdf52628d78588694e6e5b0 */
QMainWindow, QDialog { background: #f3f3f3; }
QWidget { color: #191919; font-family: 'HarmonyOS Sans SC'; font-size: 14px; }
QLineEdit, QComboBox, QTreeWidget, QTableWidget, QPlainTextEdit { background: #ffffff; color: #191919; selection-background-color: #6235f7; selection-color: #ffffff; }
QGroupBox { border: 1px solid #a7a7a7; border-radius: 4px; padding-top: 14px; }
QGroupBox::title { subcontrol-origin: margin; left: 8px; }
QWidget#previewHost { background: #ffffff; }
QWidget#previewHost[ghostSurface="true"], QWidget#ghostSampleHost { background: #6235f7; }
QLabel#titleLabel { font-size: 20px; font-weight: 600; }
QLineEdit, QComboBox, QCheckBox, QRadioButton, QToolButton { min-height: 32px; }
