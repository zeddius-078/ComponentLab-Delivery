{
  "$schemaVersion": 1,
  "$description": "Qt5 与 Qt6 公共 QSS 能力下限。生成器只允许这里登记的属性、语法值和 Token 类型。",
  "target": "qt5-qt6-common",
  "supportedProperties": {
    "background": ["color", "gradient", "asset", "string"],
    "background-color": ["color"],
    "border": ["color", "borderWidth", "dimension", "number", "string"],
    "border-bottom": ["color", "borderWidth", "dimension", "number", "string"],
    "border-color": ["color"],
    "border-radius": ["borderRadius", "dimension", "number"],
    "border-top-left-radius": ["borderRadius", "dimension", "number"],
    "border-top-right-radius": ["borderRadius", "dimension", "number"],
    "color": ["color"],
    "font-family": ["fontFamily", "string"],
    "font-size": ["fontSize", "dimension", "number"],
    "font-weight": ["fontWeight", "number"],
    "gridline-color": ["color"],
    "height": ["dimension", "number"],
    "image": ["asset", "string"],
    "max-height": ["dimension", "number"],
    "min-height": ["dimension", "number"],
    "min-width": ["dimension", "number"],
    "outline": ["color", "borderWidth", "dimension", "number", "string"],
    "padding": ["spacing", "dimension", "number"],
    "padding-left": ["spacing", "dimension", "number"],
    "padding-right": ["spacing", "dimension", "number"],
    "spacing": ["spacing", "dimension", "number"],
    "text-align": ["string"],
    "width": ["dimension", "number"]
  },
  "allowedSyntaxValues": {
    "background": ["transparent"],
    "background-color": ["transparent"],
    "border": ["none"],
    "border-bottom": ["none"],
    "outline": ["none"],
    "text-align": ["left", "right", "center"]
  },
  "forbiddenProperties": [
    "box-shadow",
    "line-height",
    "filter",
    "backdrop-filter",
    "transform",
    "transition"
  ],
  "forbiddenValuePatterns": [
    "var(",
    "calc(",
    "!important"
  ],
  "notes": {
    "innerShadow": "内阴影和复杂几何必须由运行时 Token + QPainter 实现。",
    "lineHeight": "Qt5 QSS 不支持网页式 line-height；由 .ui 或运行时字体度量处理。",
    "cssVariables": "QSS 不支持 CSS Variables；生成物必须包含已解析最终值。"
  }
}
