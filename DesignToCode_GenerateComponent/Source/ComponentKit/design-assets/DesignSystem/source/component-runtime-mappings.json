        "select": {"status":"mapped","adapter":"composite-component","qtClass":"commonWidget::Z_Select","contract":"source/component-contracts/select.json","recipe":"source/component-recipes/select.json","header":"runtime/component/Z_Select.h","implementation":"runtime/component/Z_Select.cpp"},
