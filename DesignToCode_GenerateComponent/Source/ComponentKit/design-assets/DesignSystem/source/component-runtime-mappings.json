        "card": {"status":"contract-pending","adapter":"composite-component","qtClass":"commonWidget::Z_Card","contract":"source/component-contracts/card.json","recipe":"source/component-recipes/card.json","composition":["QFrame","header-slot","content-slot","footer-slot"]},
        "chart": {"status":"contract-pending","adapter":"composite-component","qtClass":"commonWidget::Z_Chart","contract":"source/component-contracts/chart.json","recipe":"source/component-recipes/chart.json","kinds":["line","bar"],"presentations":{"bare":["commonWidget::Z_Chart"],"panel":["QFrame","header-slot","commonWidget::Z_Chart","close-action-slot"]},"note":"panel is a composition mapping; no standalone Z_ChartPanel class is assumed."},
        "tab-widget": {"status":"mapped","adapter":"native-composite","qtClass":"commonWidget::Z_TabWidget","qtBaseClass":"QTabWidget","publicIdentity":"TabWidget","children":{"tab-bar":{"qtClass":"QTabBar","role":"internal-tab-strip"},"tab-item":{"role":"internal-anatomy","notPublicComponent":true},"content-stack":{"role":"managed-page-content"}}},
        "navigation-bar": {"status":"mapped","adapter":"composite-component","qtClass":"commonWidget::Z_Navbar","contract":"source/component-contracts/navigation-bar.json","recipe":"source/component-recipes/navigation-bar.json","children":{"utility-row":{"role":"public-slot-group"},"navigation-row":{"role":"public-slot-group","children":{"tabs":{"mapsTo":"tab-widget.tab-bar","role":"child-component-anatomy"},"log-bar":{"role":"public-slot-group"}}}},"note":"Navigation Bar consumes the TabWidget tab-bar anatomy; it does not create a parallel Tabs component."},
        "side-menu": {"status":"mapped","adapter":"composite-component","qtClass":"commonWidget::Z_Sidebar","contract":"source/component-contracts/side-menu.json","recipe":"source/component-recipes/side-menu.json","publicIdentity":"Sidebar","children":{"brand-header":{"qtClass":"QWidget","parts":["QLabel:brand-logo","QToolButton:collapse-action"]},"account":{"qtClass":"QWidget","parts":["QLabel:avatar","QLabel:account-name","QLabel:account-meta","QToolButton:account-action"]},"navigation":{"identity":"Sidebar/NavItem","qtClass":"QToolButton","private":true,"markerProperty":"sidebarRoute","group":"QButtonGroup","selection":"active-route","submenu":{"expanded":"inline","collapsed":"shared-popover-menu"}},"divider":{"qtClass":"QFrame"},"footer":{"role":"optional-slot"}},"runtimeBoundary":["routeIds","routeLabels","activeRoute","collapsed","groupExpansion","routeRequested"],"note":"Sidebar/NavItem is private anatomy and has no public Z_SidebarItem SDK identity; it is not MenuItem."},
        "switch": {"status":"mapped","adapter":"native-component","qtClass":"commonWidget::Z_Switch","contract":"source/component-contracts/switch.json","recipe":"source/component-recipes/switch.json","header":"runtime/component/Z_DesignComponents.h","implementation":"runtime/component/Z_DesignComponents.cpp","qtBaseClass":"QAbstractButton","runtimeBoundary":["value","state","label","loadingLifecycle"],"note":"Switch is a binary setting control; it is not a Checkbox alias. Loading uses shared Spinner visuals and runtime playback."},
        "badge": {"status":"mapped","adapter":"custom-painted-widget","qtClass":"commonWidget::Z_Badge","contract":"source/component-contracts/badge.json","recipe":"source/component-recipes/badge.json","header":"runtime/component/Z_FoundationComponents.h","implementation":"runtime/component/Z_FoundationComponents.cpp","qtBaseClass":"QWidget","runtimeBoundary":["label","kind","tone","accessibilityLabel"],"note":"Badge is a non-interactive static status marker; Text and Dot are presentations, not interaction states."},
        "chip": {"status":"mapped","adapter":"native-behavior-custom-painted","qtClass":"commonWidget::Z_Chip","contract":"source/component-contracts/chip.json","recipe":"source/component-recipes/chip.json","header":"runtime/component/Z_DesignComponents.h","implementation":"runtime/component/Z_DesignComponents.cpp","qtBaseClass":"QAbstractButton","runtimeBoundary":["value","orientation","label","groupSelection"],"note":"Chip reuses QAbstractButton checkable behavior; orientation/value/state remain independent. It is not Badge or dismissible Tag."},
        "number-input": {"status":"mapped","adapter":"composite-component","qtClass":"commonWidget::Z_NumberInput","contract":"source/component-contracts/number-input.json","recipe":"source/component-recipes/number-input.json","header":"runtime/component/Z_FoundationComponents.h","implementation":"runtime/component/Z_FoundationComponents.cpp","qtBaseClasses":["QWidget","QSpinBox","QDoubleSpinBox"],"runtimeBoundary":["type","value","minimum","maximum","singleStep","controls","state","precision","locale","grouping"],"note":"NumberInput is the public identity; SpinBox and DoubleSpinBox remain internal Qt editor adapters."},
        "statistic": {"status":"mapped","adapter":"custom-painted-widget","qtClass":"commonWidget::Z_Statistic","contract":"source/component-contracts/statistic.json","recipe":"source/component-recipes/statistic.json","header":"runtime/component/Z_DesignComponents.h","implementation":"runtime/component/Z_DesignComponents.cpp","qtBaseClass":"QWidget","runtimeBoundary":["size","state","titleText","numericValue","localeName","precision","useGrouping","prefix","suffix"],"note":"Statistic is the canonical data-display value component. DataDisplay remains a historical alias; aggregation and datasets stay outside the component."},
        "date-time-input": {"status":"contract-pending","adapter":"custom-composite-with-qt-temporal-adapters","qtClass":"commonWidget::Z_DateTimeInput","qtBaseClasses":["QWidget","QDateEdit/QTimeEdit/QDateTimeEdit (internal adapters)","custom calendar popup surface"],"contract":"source/component-contracts/date-time-input.json","recipe":"source/component-recipes/date-time-input.json","runtimeBoundary":["mode","value","displayFormat","locale","calendar","minimum","maximum","selectionMode","state","popupLifecycle","monthNavigation","rangeSelection"],"note":"Native Qt editors provide temporal values and parsing only. The field, calendar grid, range highlight, navigation and popup composition are project-owned; DatePicker/TimePicker/DateTimePicker remain legacy aliases."}
      }
    }
  }
}
