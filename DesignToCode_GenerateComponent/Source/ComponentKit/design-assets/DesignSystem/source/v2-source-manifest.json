        {
          "id": "05.composite",
          "key": "composite",
          "path": "source/{typography,gradient,shadow,blur,motion}.json",
          "role": "reusable-visual-composites",
          "status": "package-backed"
        },
        {
          "id": "06.component",
          "key": "component",
          "path": "source/component-recipes/*.json",
          "role": "component-owned-visual-contract",
          "status": "active-source"
        },
        {
          "id": "07.content",
          "key": "content",
          "path": "source/content/*.json",
          "role": "terminology-and-localized-instance-content",
          "status": "active"
        }
      ],
      "compatibility": {
        "loaderLayers": ["primitive", "profile", "theme", "semantic", "component"],
        "themeModeOwner": "theme.$modeOverrides",
        "themeMigrationTarget": "source/theme.json",
        "themeMigrationStatus": "completed-first-slice",
        "compositePackagesRemainPhysicallySeparate": true,
        "contentIsNotAVisualTokenLayer": true,
        "contentScope": ["terminology", "localized-copy", "instance-text", "locale-adaptation"],
        "contentExcludes": ["slot-structure", "runtime-state", "data-source", "events", "business-rules"],
        "contentGovernance": {
          "status": "approved",
          "defaultLocale": "en-US",
          "fallbackLocale": "en-US",
          "keyLanguage": "en",
          "defaultPolicy": "all-components-inherit-english-content-policy",
          "componentSpecificRefinement": "allowed-only-in-component-contract; cannot change locale or add visual/runtime ownership",
          "uncontractedComponents": "inherit-global-policy"
        },
        "generatedOutputsAreNotSourceLayers": true
      }
    },
    "componentRegistry": "source/component-registry.json",
    "componentRecipes": "source/component-recipes/*.json",
    "runtimeMappings": "source/component-runtime-mappings.json",
    "compositeRegistry": "source/composite-registry.json",
    "atomicPrimitive": "source/primitive.json",
    "compositePackages": "source/{typography,gradient,shadow,blur,motion}.json",
    "migrationAliases": "source/migrations/token-aliases.json"
    ,"componentValueEvidence": "source/component-value-evidence/*.json"
    ,"figmaVariableArchitecture": "DSM/Component is generated from V2 bindings; imports/reference/*.json is value-only evidence and never a variable-name source"
    ,"figmaStructureAuditStatus": "not-currently-measured; historical reports are available through Git only"
    ,"materializationPolicy": {
      "design": {
        "mode": "sparse",
        "consumers": ["Figma", "Pixso"],
        "includes": [
          "primitive-and-semantic-references",
          "component-base-values",
          "component-sparse-overrides",
          "composite-references",
          "approved-structure-and-slot-bindings"
        ],
        "excludes": [
          "generated/component.json",
          "generated/component-combinations.json",
          "runtime-expanded-legal-combinations",
          "business-data-and-runtime-state"
        ],
        "logicalCombinationsAreNotDesignVariables": true,
        "numericProjectTarget": false,
        "governance": "model-governed; do not back-propagate external Figma counts into V2 source",
        "figmaCollectionBudget": {
          "platformHardMaxVariablesPerCollection": 5000,
          "source": "https://help.figma.com/hc/en-us/articles/15145852043927-Create-and-manage-variables-and-collections"
        },
        "pixsoCollectionBudget": {
          "hardMaxVariablesPerCollection": null,
          "validation": "adapter-measured",
          "reason": "No fixed public limit is treated as a project fact; sync must measure the target workspace before publication."
        },
        "partitioning": "only-after-curation; never split the generated Cartesian product into design collections"
      },
      "runtime": {
        "mode": "expanded",
        "consumers": ["Qt", "Vue", "CSS"],
        "sources": [
          "source/component-registry.json",
          "source/component-contracts/*.json",
          "source/component-recipes/*.json",
          "source/composite-registry.json"
        ],
        "outputs": [
          "generated/component.json",
          "generated/component-combinations.json",
          "generated/composites/*"
        ],
        "designImportForbidden": true
      }
    }
    ,"figmaPublicComponentSets": {
      "checkbox": "2258:16082",
