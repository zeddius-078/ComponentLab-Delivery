        "profile",
        "theme",
        "semantic",
        "composite",
        "component",
        "content"
      ],
      "layers": [
        {
          "id": "01.primitive",
          "key": "primitive",
          "path": "source/primitive.json",
          "role": "atomic-values",
          "status": "active"
        },
        {
          "id": "02.profile",
          "key": "profile",
          "path": "source/profile.json",
          "role": "platform-resolution-density",
          "status": "active"
        },
        {
          "id": "03.theme",
          "key": "theme",
          "path": "source/theme.json",
          "role": "surface-and-theme-context",
          "status": "active"
