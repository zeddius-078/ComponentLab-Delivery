    "713:2"
  ],
  "figmaComponentSet": "2256:15923",
  "legacyFigmaComponentSets": [
    "712:27",
    "713:21"
  ],
  "variantAxes": {
    "density": [
      "compact",
      "comfortable"
    ],
    "state": [
      "default",
      "hover",
      "selected",
      "disabled",
      "selected-hover",
      "focus-visible"
    ]
  },
  "contentProperties": {
