    },
    "emptyStateText": {
      "kind": "localized-content-key",
      "source": "tree-empty-state-slot",
      "defaultLocale": "en-US",
      "fallbackLocale": "en-US"
    }
  },
  "variableNamespace": {
    "collection": "DSM/Component",
    "prefix": "tree/",
    "evidence": "source/component-value-evidence/tree.json"
  },
  "bindingRules": [
    {
      "figmaSlot": "Tree/Container",
      "canonicalPattern": "component.tree.base.state.default.slot.container.*",
      "valueEvidence": "tree/color/bg/*,tree/padding/default"
    },
    {
      "figmaSlot": "Tree/Item",
      "canonicalPattern": "component.tree.base.state.*.slot.item.*",
      "valueEvidence": "tree/color/bg/*,tree/content/height/md"
    },
    {
      "figmaSlot": "Tree/Content",
      "canonicalPattern": "component.tree.base.state.default.slot.content.*",
      "valueEvidence": "tree/content/*,tree/color/text/*"
