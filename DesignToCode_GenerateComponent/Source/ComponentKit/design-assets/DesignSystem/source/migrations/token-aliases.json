{
  "$description": "V2 migration-only aliases for legacy Figma Typography styles and variable namespaces. This file is not a runtime token source.",
  "$version": "2.0",
  "$status": "migration-only",
  "sourceOfTruth": "source/composite-registry.json",
  "runtimeConsumable": false,
  "figma": {
    "migrationPolicy": "parallel-rebuild",
    "legacyPolicy": "retain-legacy-read-only",
    "legacyStylePrefix": "DSM/",
    "targetStylePrefix": "DSM/Typography/",
    "targetVariableCollection": "DSM/Typography",
    "targetModes": ["standard", "wide"],
    "defaultMode": "standard",
    "styleMappings": {
      "DSM/Heading/H1": "DSM/Typography/heading/heading-1",
      "DSM/Heading/H2": "DSM/Typography/heading/heading-2",
      "DSM/Heading/H3": "DSM/Typography/heading/heading-3",
      "DSM/Heading/H4": "DSM/Typography/heading/heading-4",
      "DSM/Heading/Dialog": "DSM/Typography/heading/heading-dialog",
      "DSM/Heading/Message": "DSM/Typography/heading/heading-message",
      "DSM/Body/Default": "DSM/Typography/body/body-1",
      "DSM/Body/Small": "DSM/Typography/body/body-small",
      "DSM/Body/Compact": "DSM/Typography/body/body-compact",
      "DSM/Body/Emphasis": "DSM/Typography/body/body-emphasis",
      "DSM/Label/Default": "DSM/Typography/label/label-1",
      "DSM/Label/Small": "DSM/Typography/label/label-small",
      "DSM/Label/Large": "DSM/Typography/label/label-large",
      "DSM/Label/Emphasis": "DSM/Typography/label/label-emphasis",
      "DSM/Label/Micro": "DSM/Typography/label/label-micro",
      "DSM/Label/AuxiliaryEmphasis": "DSM/Typography/label/label-auxiliary-emphasis",
      "DSM/Label/Caption": "DSM/Typography/label/label-caption",
      "DSM/Label/Auxiliary": "DSM/Typography/label/label-default-auxiliary",
      "DSM/Label/CompactAuxiliary": "DSM/Typography/label/label-compact-auxiliary",
      "DSM/Data/Numeric": "DSM/Typography/data/data-1",
      "DSM/Data/Affix": "DSM/Typography/data/data-affix",
      "DSM/Data/Unit": "DSM/Typography/data/data-unit",
      "DSM/Data/EmphasisUnit": "DSM/Typography/data/data-emphasis-unit",
      "DSM/Data/CompactUnit": "DSM/Typography/data/data-compact-unit",
      "DSM/Display/Chrome": "DSM/Typography/display/display-chrome",
      "DSM/Display/Large": "DSM/Typography/display/display-1",
      "DSM/Subtitle/SubTitle": "DSM/Typography/subtitle/subtitle-1",
      "DSM/Subtitle/FormLabel": "DSM/Typography/subtitle/subtitle-form-label"
    },
    "legacyVariableNamespaces": {
      "typography/font-size": "Typography Composite member fontSize",
      "typography/line-height": "Typography Composite member lineHeight",
      "typography/font-weight": "Typography Composite member fontWeight",
      "typography/letter-spacing": "Typography Composite member letterSpacing"
    },
    "fontFamilyMigration": {
      "legacy": "Inter",
      "target": "HarmonyOS Sans",
      "fallback": "HarmonyOS Sans SC",
      "fallbackBinding": "composite-metadata-and-platform-adapter"
    }
  }
}
