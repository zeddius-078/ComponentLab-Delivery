{
  "id": "CHECKBOX-SURFACE-R4-STOKEN",
  "status": "ISOLATED-DEMO-NOT-DESIGN-APPROVED",
  "units": "Qt logical px; font px; shadow blur = Qt QGraphicsBlurEffect radius; alpha 0..1",
  "fontFamily": "{base.stoken.typography.font-family.harmony-os-sans-sc}",
  "gradientStateBindings": {
    "default": {
      "high": "hover",
      "low": "pressed"
    },
    "hover": {
      "high": "hover",
      "low": "default"
    },
    "pressed": {
      "high": "default",
      "low": "pressed"
    },
    "disabled": {
      "high": "disabled",
      "low": "disabled"
    }
  },
  "checkbox": {
    "radius": "{component.basic.checkbox.radius}",
    "borderWidth": "{component.basic.checkbox.borderWidth}",
    "focusWidth": "{component.basic.checkbox.focus.borderWidth}",
    "focusGap": 2,
    "sizes": {
      "sm": {
        "indicator": "{component.basic.checkbox.sizes.sm.indicator}",
        "hitTarget": "{component.basic.checkbox.sizes.sm.hitTarget}",
        "fontSize": "{component.basic.checkbox.sizes.sm.fontSize}",
        "spacing": "{component.basic.checkbox.sizes.sm.spacing}"
      },
      "lg": {
        "indicator": "{component.basic.checkbox.sizes.lg.indicator}",
        "hitTarget": "{component.basic.checkbox.sizes.lg.hitTarget}",
        "fontSize": "{component.basic.checkbox.sizes.lg.fontSize}",
        "spacing": "{component.basic.checkbox.sizes.lg.spacing}"
      }
    },
    "palette": {
      "text": "{component.basic.checkbox.text}",
      "disabledText": "{component.basic.checkbox.disabledText}",
      "focus": "{component.basic.checkbox.focus.border}",
      "onAccent": "{semantic.color.text.onBrand}",
      "unchecked": "{component.basic.checkbox.state.unchecked.background}",
      "uncheckedHover": "{component.basic.checkbox.state.unchecked.hoverBackground}",
      "uncheckedPressed": "{component.basic.checkbox.state.unchecked.pressedBackground}",
      "uncheckedDisabled": "{component.basic.checkbox.state.unchecked.disabledBackground}",
      "border": "{component.basic.checkbox.state.unchecked.border}",
      "borderHover": "{component.basic.checkbox.state.unchecked.hoverBorder}",
      "borderPressed": "{component.basic.checkbox.state.unchecked.pressedBorder}",
      "borderDisabled": "{component.basic.checkbox.state.unchecked.disabledBorder}",
      "accent": "{component.basic.checkbox.state.selected.background}",
      "accentHover": "{component.basic.checkbox.state.selected.hoverBackground}",
      "accentPressed": "{component.basic.checkbox.state.selected.pressedBackground}",
      "accentDisabled": "{component.basic.checkbox.state.selected.disabledBackground}"
    },
    "glyphs": {
      "checked": ":/icons/checkbox-check.svg",
      "mixed": ":/icons/checkbox-mixed.svg"
    }
  },
  "surfacePresets": [
    {
      "id": "solid",
      "label": "纯色",
      "fill": "solid",
      "shadows": []
    },
    {
      "id": "gradient",
      "label": "渐变",
      "fill": "linearGradient",
      "from": [
        0,
        0
      ],
      "to": [
        0,
        1
      ],
      "stops": [
        {
          "at": 0,
          "color": "high"
        },
        {
          "at": 1,
          "color": "low"
        }
      ],
      "shadows": []
    },
    {
      "id": "inset",
      "label": "纯色 + 内阴影",
      "fill": "solid",
      "shadows": [
        {
          "kind": "inset",
          "color": "#000000",
          "alpha": 0.36,
          "x": 0,
          "y": 2,
          "blur": 5,
          "spread": 0
        }
      ]
    },
    {
      "id": "gradient-inset",
      "label": "渐变 + 内阴影",
      "fill": "linearGradient",
      "from": [
        0,
        0
      ],
      "to": [
        0,
        1
      ],
      "stops": [
        {
          "at": 0,
          "color": "high"
        },
        {
          "at": 0.5,
          "color": "background"
        },
        {
          "at": 1,
          "color": "low"
        }
      ],
      "shadows": [
        {
          "kind": "inset",
          "color": "#000000",
          "alpha": 0.36,
          "x": 0,
          "y": 2,
          "blur": 5,
          "spread": 0
        }
      ]
    },
    {
      "id": "outline",
      "label": "仅描边",
      "fill": "outline",
      "shadows": []
    },
    {
      "id": "elevated",
      "label": "纯色 + 外阴影",
      "fill": "solid",
      "shadows": [
        {
          "kind": "outer",
          "color": "#000000",
          "alpha": 0.3,
          "x": 0,
          "y": 3,
          "blur": 7,
          "spread": 0
        }
      ]
    },
    {
      "id": "gradient-elevated",
      "label": "渐变 + 内外阴影",
      "fill": "linearGradient",
      "from": [
        0,
        0
      ],
      "to": [
        0,
        1
      ],
      "stops": [
        {
          "at": 0,
          "color": "high"
        },
        {
          "at": 1,
          "color": "low"
        }
      ],
      "shadows": [
        {
          "kind": "inset",
          "color": "#FFFFFF",
          "alpha": 0.28,
          "x": 0,
          "y": 1,
          "blur": 3,
          "spread": 0
        },
        {
          "kind": "outer",
          "color": "#000000",
          "alpha": 0.3,
          "x": 0,
          "y": 3,
          "blur": 7,
          "spread": 0
        }
      ]
    }
  ],
  "decisions": {
    "C06": "Gradient directions, stops, focusGap and shadow parameters are explicit demo extensions awaiting UX approval. Source primitives are a locked input, not edited here.",
    "C07": "high/background/low are palette bindings resolved per component, profile and state. A stop also accepts a source alias or sRGB color.",
    "C08": "Disabled removes decorative soft shadows. Checkbox uses solid disabled fill; Button preserves explicit supplied disabled gradient stops. Button Text/Link/Ghost preserve transparent semantics for shared presets; geometry material has its own capability policy.",
    "C09": "Preset IDs are open data keys, not an enum. Multiple inset/outer shadows are supported, maximum eight for bounded cache/memory cost.",
    "STOKEN": "Checkbox uses sToken selection-control + shared semantic mappings; no checkbox-specific full source state set. Existing material geometry retained."
  }
}
