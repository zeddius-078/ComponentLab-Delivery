{
  "id": "CHECKBOX-SURFACE-R5-V2-ONLY",
  "status": "ISOLATED-DEMO-NOT-DESIGN-APPROVED",
  "units": "Qt logical px; font px; shadow blur = Qt QGraphicsBlurEffect radius; alpha 0..1",
  "fontFamily": "{semantic.typography.font-family.harmony-os-sans}",
  "gradientStateBindings": {
    "default": {
      "high": "hover",
      "low": "pressed"
    },
    "hover": {
      "high": "hover",
      "low": "default"
    },
    "pressed": {
      "high": "default",
      "low": "pressed"
    },
    "disabled": {
      "high": "disabled",
      "low": "disabled"
    }
  },
  "checkbox": {
    "radius": "{component.checkbox.base.shared.slot.indicator.border-radius}",
    "borderWidth": "{semantic.border-width.boundary-default}",
    "focusWidth": "{semantic.border-width.focus-ring}",
    "focusGap": 2,
    "sizes": {
      "sm": {
        "indicator": "{component.checkbox.base.size.small.slot.indicator.visual-size}",
        "hitTarget": "{adapter.qt.checkbox.hitTarget.sm}",
        "fontSize": "{component.checkbox.base.shared.slot.label.font-size}",
        "spacing": "{component.checkbox.base.shared.slot.content.gap}"
      },
      "lg": {
        "indicator": "{component.checkbox.base.size.large.slot.indicator.visual-size}",
        "hitTarget": "{adapter.qt.checkbox.hitTarget.lg}",
        "fontSize": "{component.checkbox.base.shared.slot.label.font-size}",
        "spacing": "{component.checkbox.base.shared.slot.content.gap}"
      }
    },
    "palette": {
      "text": "{semantic.color.text.primary}",
      "disabledText": "{semantic.color.text.disabled}",
      "focus": "{semantic.color.interactive.brand.focus-ring}",
      "onAccent": "{semantic.color.text.invert}",
      "unchecked": "{semantic.color.background.control-default}",
      "uncheckedHover": "{semantic.color.background.hover}",
      "uncheckedPressed": "{semantic.color.background.pressed}",
      "uncheckedDisabled": "{semantic.color.background.disabled}",
      "border": "{semantic.color.icon.secondary}",
      "borderHover": "{semantic.color.border.hover}",
      "borderPressed": "{semantic.color.border.primary}",
      "borderDisabled": "{semantic.color.border.disabled}",
      "accent": "{semantic.color.interactive.brand.default}",
      "accentHover": "{semantic.color.interactive.brand.hover}",
      "accentPressed": "{semantic.color.interactive.brand.pressed}",
      "accentDisabled": "{semantic.color.icon.disabled}"
    },
    "glyphs": {
      "checked": ":/icons/checkbox-check.svg",
      "mixed": ":/icons/checkbox-mixed.svg"
    }
  },
  "surfacePresets": [
    {
      "id": "solid",
      "label": "纯色",
      "fill": "solid",
      "shadows": []
    },
    {
      "id": "gradient",
      "label": "渐变",
      "fill": "linearGradient",
      "from": [
        0,
        0
      ],
      "to": [
        0,
        1
      ],
      "stops": [
        {
          "at": 0,
          "color": "high"
        },
        {
          "at": 1,
          "color": "low"
        }
      ],
      "shadows": []
    },
    {
      "id": "inset",
      "label": "纯色 + 内阴影",
      "fill": "solid",
      "shadows": [
        {
          "kind": "inset",
          "color": "#000000",
          "alpha": 0.36,
          "x": 0,
          "y": 2,
          "blur": 5,
          "spread": 0
        }
      ]
    },
    {
      "id": "gradient-inset",
      "label": "渐变 + 内阴影",
      "fill": "linearGradient",
      "from": [
        0,
        0
      ],
      "to": [
        0,
        1
      ],
      "stops": [
        {
          "at": 0,
          "color": "high"
        },
        {
          "at": 0.5,
          "color": "background"
        },
        {
          "at": 1,
          "color": "low"
        }
      ],
      "shadows": [
        {
          "kind": "inset",
          "color": "#000000",
          "alpha": 0.36,
          "x": 0,
          "y": 2,
          "blur": 5,
          "spread": 0
        }
      ]
    },
    {
      "id": "outline",
      "label": "仅描边",
      "fill": "outline",
      "shadows": []
    },
    {
      "id": "elevated",
      "label": "纯色 + 外阴影",
      "fill": "solid",
      "shadows": [
        {
          "kind": "outer",
          "color": "#000000",
          "alpha": 0.3,
          "x": 0,
          "y": 3,
          "blur": 7,
          "spread": 0
        }
      ]
    },
    {
      "id": "gradient-elevated",
      "label": "渐变 + 内外阴影",
      "fill": "linearGradient",
      "from": [
        0,
        0
      ],
      "to": [
        0,
        1
      ],
      "stops": [
        {
          "at": 0,
          "color": "high"
        },
        {
          "at": 1,
          "color": "low"
        }
      ],
      "shadows": [
        {
          "kind": "inset",
          "color": "#FFFFFF",
          "alpha": 0.28,
          "x": 0,
          "y": 1,
          "blur": 3,
          "spread": 0
        },
        {
          "kind": "outer",
          "color": "#000000",
          "alpha": 0.3,
          "x": 0,
          "y": 3,
          "blur": 7,
          "spread": 0
        }
      ]
    }
  ],
  "decisions": {
    "C06": "Gradient directions, stops, focusGap and shadow parameters are explicit demo extensions awaiting UX approval. Source primitives are a locked input, not edited here.",
    "C07": "high/background/low are palette bindings resolved per component, profile and state. A stop also accepts a source alias or sRGB color.",
    "C08": "Disabled removes decorative soft shadows. Checkbox uses solid disabled fill; Button preserves explicit supplied disabled gradient stops. Button Text/Link/Ghost preserve transparent semantics for shared presets; geometry material has its own capability policy.",
    "C09": "Preset IDs are open data keys, not an enum. Multiple inset/outer shadows are supported, maximum eight for bounded cache/memory cost.",
    "V2": "Checkbox uses the canonical component/selection-control recipes plus shared semantic mappings. Existing material geometry is retained in the V2 contract."
  }
}
