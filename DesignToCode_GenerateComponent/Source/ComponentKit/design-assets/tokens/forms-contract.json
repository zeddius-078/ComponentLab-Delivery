{
  "id": "COMPONENT-LAB-FORMS-R4-STOKEN",
  "status": "PROJECT-ADAPTER-PROPOSAL",
  "sourcePolicy": "sToken overlay via the canonical parser; Input and Select share component.basic.input. Unspecified popup bounds and layout defaults remain explicit project contract values.",
  "fontFamily": "{semantic.typography.font-family.harmony-os-sans}",
  "fallbackFontFamily": "HarmonyOS Sans SC",
  "icons": {
    "clear": ":/icons/x.svg",
    "showPassword": ":/icons/eye.svg",
    "hidePassword": ":/icons/eye-off.svg",
    "search": ":/icons/search.svg",
    "arrow": ":/icons/chevron-down.svg"
  },
  "metrics": {
    "gap": "{semantic.space.icon-text}",
    "labelGap": "{semantic.space.vertical.standard}",
    "hintGap": "{semantic.space.vertical.micro}",
    "borderWidth": "{semantic.border-width.boundary-default}",
    "radius": "{component.input.base.default.container.radius}",
    "focusWidth": "{component.input.base.focused.focus-ring.width}",
    "actionSize": "{adapter.qt.dimension.control-height.interactive-size}",
    "actionInset": "{semantic.space.vertical.micro}",
    "iconSize": "{semantic.visualization-size.xs}",
    "hintFontSize": "{semantic.typography.label.default-auxiliary.font-size}",
    "labelFontSize": "{semantic.typography.label.default.font-size}",
    "optionHeight": "{adapter.qt.dimension.control-height.md}",
    "popupPadding": "{semantic.layout.padding.inline.micro}",
    "popupGap": "{semantic.space.vertical.micro}",
    "popupRadius": "{semantic.radius.control-default}",
    "tagGap": "{semantic.space.horizontal.micro}",
    "tagRadius": "{semantic.radius.control-sm}",
    "tagHeight": "{adapter.qt.dimension.control-height.interactive-size}",
    "tagPadding": "{semantic.layout.padding.inline.compact}",
    "popupMaxHeight": 256,
    "popupMinWidth": 160,
    "fieldPreferredWidth": 320,
    "fieldMinimumWidth": 120,
    "textAreaMinRows": 2,
    "textAreaMaxRows": 5
  },
  "sizes": {
    "sm": {
      "height": "{adapter.qt.input.size.sm.height}",
      "paddingInline": "{component.input.size.small.container.padding-inline}",
      "paddingBlock": "{component.button.base.default.container.padding-block}",
      "fontSize": "{component.input.base.default.content.font-size}",
      "lineHeight": "{semantic.typography.body.default.line-height}"
    },
    "md": {
      "height": "{adapter.qt.input.size.md.height}",
      "paddingInline": "{component.input.size.medium.container.padding-inline}",
      "paddingBlock": "{component.button.base.default.container.padding-block}",
      "fontSize": "{component.input.base.default.content.font-size}",
      "lineHeight": "{semantic.typography.body.default.line-height}"
    },
    "lg": {
      "height": "{adapter.qt.input.size.lg.height}",
      "paddingInline": "{component.input.size.large.container.padding-inline}",
      "paddingBlock": "{component.button.base.default.container.padding-block}",
      "fontSize": "{component.input.base.default.content.font-size}",
      "lineHeight": "{semantic.typography.subtitle.sub-title.line-height}"
    }
  },
  "palette": {
    "background": "{component.input.base.default.container.background-color}",
    "text": "{component.input.base.default.content.color}",
    "placeholder": "{component.input.base.default.placeholder.color}",
    "border": "{component.input.base.default.border.color}",
    "hoverBorder": "{component.input.base.hover.border.color}",
    "focusBorder": "{component.input.base.focused.border.color}",
    "focusOutline": "{component.basic.input.state.focus.outline}",
    "disabledBackground": "{component.basic.input.state.disabled.background}",
    "disabledText": "{component.input.base.disabled.content.color}",
    "disabledBorder": "{component.basic.input.state.disabled.border}",
    "errorBorder": "{component.input.base.error.border.color}",
    "errorBackground": "{component.input.base.error.container.background-color}",
    "warningBorder": "{semantic.color.status.warning.default}",
    "warningBackground": "{primitive.color.functional.yellow-subtle}",
    "muted": "{semantic.color.text.muted}",
    "filledBackground": "{semantic.color.background.surface-muted}",
    "gradientHigh": "{semantic.color.background.surface-raised}",
    "gradientLow": "{primitive.color.highlight.purple-15}",
    "optionHover": "{semantic.color.background.hover}",
    "optionSelected": "{semantic.color.interactive.brand.subtle}",
    "accent": "{semantic.color.interactive.brand.default}",
    "tagBackground": "{semantic.color.background.surface-muted}"
  },
  "decisions": {
    "F01": "Global text uses bundled HarmonyOS Sans; simplified-Chinese glyphs fall back only to bundled HarmonyOS Sans SC.",
    "F02": "Popup bounds, preferred width and textarea row defaults remain local parameters. Action Loading reuses the Button contract.",
    "F03": "The sToken embedded interaction size resolves to 24px in all four current runtime configurations; the shared Input/Select field adapter applies a 32px minimum height and 14px minimum body font size.",
    "F04": "Surface presets use the same checkbox-contract.json data; borderless and underlined preserve their structural border semantics and have no decorative shadow."
  }
}
