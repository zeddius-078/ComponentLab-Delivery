      "lineHeight": "{base.lineHeight.body-sm}"
    },
    "lg": {
      "height": "{component.basic.input.size.lg.height}",
      "paddingInline": "{component.basic.input.size.lg.paddingInline}",
      "paddingBlock": "{component.basic.input.size.lg.paddingBlock}",
      "fontSize": "{component.basic.input.size.lg.fontSize}",
      "lineHeight": "{base.lineHeight.body-md}"
    }
  },
  "palette": {
    "background": "{component.basic.input.state.default.background}",
    "text": "{component.basic.input.state.default.text}",
    "placeholder": "{component.basic.input.state.default.placeholder}",
    "border": "{component.basic.input.state.default.border}",
    "hoverBorder": "{component.basic.input.state.hover.border}",
    "focusBorder": "{component.basic.input.state.focus.border}",
    "focusOutline": "{component.basic.input.state.focus.outline}",
    "disabledBackground": "{component.basic.input.state.disabled.background}",
    "disabledText": "{component.basic.input.state.disabled.text}",
    "disabledBorder": "{component.basic.input.state.disabled.border}",
    "errorBorder": "{component.basic.input.state.error.border}",
    "errorBackground": "{component.basic.input.state.error.background}",
    "warningBorder": "{semantic.color.status.warning}",
    "warningBackground": "{semantic.color.status.warning-bg}",
    "muted": "{semantic.color.text.muted}",
    "filledBackground": "{semantic.color.background.surface-muted}",
    "gradientHigh": "{semantic.color.background.elevated}",
    "gradientLow": "{semantic.color.action.primary-bg-hover}",
    "optionHover": "{semantic.color.background.interactive-hover}",
    "optionSelected": "{semantic.color.action.primary-bg}",
    "accent": "{semantic.color.action.primary}",
    "tagBackground": "{semantic.color.background.surface-muted}"
  },
  "decisions": {
    "F01": "Font family is sToken HarmonyOS Sans SC; not bundled. Qt fallback applies when unavailable; Field retains Microsoft YaHei UI fallback.",
    "F02": "Popup bounds, preferred width and textarea row defaults remain local parameters. Action Loading reuses the Button contract.",
    "F03": "The sToken embedded interaction size resolves to 24px in all four current runtime configurations; the shared Input/Select field adapter applies a 32px minimum height and 14px minimum body font size.",
    "F04": "Surface presets use the same checkbox-contract.json data; borderless and underlined preserve their structural border semantics and have no decorative shadow."
  }
