  "sourcePolicy": "sToken overlay via the canonical parser; Input and Select share component.basic.input. Unspecified popup bounds and layout defaults remain explicit project contract values.",
  "fontFamily": "{base.stoken.typography.font-family.harmony-os-sans-sc}",
  "fallbackFontFamily": "Microsoft YaHei UI",
  "icons": {
    "clear": ":/icons/x.svg",
    "showPassword": ":/icons/eye.svg",
    "hidePassword": ":/icons/eye-off.svg",
    "search": ":/icons/search.svg",
    "arrow": ":/icons/chevron-down.svg"
  },
  "metrics": {
    "gap": "{base.stoken.metric.space.icon-text}",
    "labelGap": "{base.stoken.metric.space.vertical.standard}",
    "hintGap": "{base.stoken.metric.space.vertical.micro}",
    "borderWidth": "{base.borderWidth.hairline}",
    "radius": "{component.basic.input.radius}",
    "focusWidth": "{component.basic.input.state.focus.outlineWidth}",
    "actionSize": "{semantic.dimension.control.interactive-size}",
    "actionInset": "{base.stoken.metric.space.vertical.micro}",
    "iconSize": "{base.stoken.metric.visualization-size.xs}",
    "hintFontSize": "{base.stoken.typography.font-size.label.default-auxiliary}",
    "labelFontSize": "{base.stoken.typography.font-size.label.default}",
