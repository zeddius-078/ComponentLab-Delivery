    "popupMinWidth": 160,
    "fieldPreferredWidth": 320,
    "fieldMinimumWidth": 120,
    "textAreaMinRows": 2,
    "textAreaMaxRows": 5
  },
  "sizes": {
    "sm": {
      "height": "{component.basic.input.size.sm.height}",
      "paddingInline": "{component.basic.input.size.sm.paddingInline}",
