/* Z_FileDialog <- QFileDialog; compiled from the active Token profile. */
*[designSystemClass="commonWidget::Z_FileDialog"] {
    color: @FOREGROUND@;
    background-color: @SURFACE@;
    font-size: @FONT_SIZE@px;
}
*[designSystemClass="commonWidget::Z_FileDialog"]:disabled {
    color: @DISABLED_TEXT@;
    background-color: @DISABLED@;
    border-color: @DISABLED_BORDER@;
}
