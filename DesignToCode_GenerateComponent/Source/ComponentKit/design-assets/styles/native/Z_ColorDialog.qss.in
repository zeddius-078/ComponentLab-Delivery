/* Z_ColorDialog <- QColorDialog; compiled from the active Token profile. */
*[designSystemClass="commonWidget::Z_ColorDialog"] {
    color: @FOREGROUND@;
    background-color: @SURFACE@;
    font-size: @FONT_SIZE@px;
}
*[designSystemClass="commonWidget::Z_ColorDialog"]:disabled {
    color: @DISABLED_TEXT@;
    background-color: @DISABLED@;
    border-color: @DISABLED_BORDER@;
}
