/* Z_TableView <- QTableView; compiled from the active Token profile. */
*[designSystemClass="commonWidget::Z_TableView"] {
    color: @FOREGROUND@;
    background-color: @SURFACE@;
    font-size: @FONT_SIZE@px;
}
*[designSystemClass="commonWidget::Z_TableView"]:disabled {
    color: @DISABLED_TEXT@;
    background-color: @DISABLED@;
    border-color: @DISABLED_BORDER@;
}
*[designSystemClass="commonWidget::Z_TableView"] {
    border: 1px solid @BORDER@;
    border-radius: @RADIUS@px;
}
