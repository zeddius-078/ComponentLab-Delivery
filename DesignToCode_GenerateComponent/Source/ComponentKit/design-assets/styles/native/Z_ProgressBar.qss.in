/* Z_ProgressBar <- QProgressBar; compiled from the active Token profile. */
*[designSystemClass="commonWidget::Z_ProgressBar"] {
    color: @FOREGROUND@;
    background-color: @SURFACE@;
    font-size: @FONT_SIZE@px;
}
*[designSystemClass="commonWidget::Z_ProgressBar"]:disabled {
    color: @DISABLED_TEXT@;
    background-color: @DISABLED@;
    border-color: @DISABLED_BORDER@;
}
*[designSystemClass="commonWidget::Z_ProgressBar"] {
    min-height: @HEIGHT@px;
    border: 1px solid @BORDER@;
    border-radius: @RADIUS@px;
    text-align: center;
}
*[designSystemClass="commonWidget::Z_ProgressBar"]::chunk { background-color: @PRIMARY@; border-radius: @RADIUS@px; }
