/* Z_ScrollArea <- QScrollArea; compiled from the active Token profile. */
*[designSystemClass="commonWidget::Z_ScrollArea"] {
    color: @FOREGROUND@;
    background-color: @SURFACE@;
    font-size: @FONT_SIZE@px;
}
*[designSystemClass="commonWidget::Z_ScrollArea"]:disabled {
    color: @DISABLED_TEXT@;
    background-color: @DISABLED@;
    border-color: @DISABLED_BORDER@;
}
*[designSystemClass="commonWidget::Z_ScrollArea"] {
    border: 1px solid @BORDER@;
    border-radius: @RADIUS@px;
}
*[designSystemClass="commonWidget::Z_ScrollArea"][figmaSnapshotState="Focus"],
*[designSystemClass="commonWidget::Z_ScrollArea"]:focus[focusIndicatorVisible="true"] { border: 2px solid @FOCUS@; }
*[designSystemClass="commonWidget::Z_ScrollArea"] QWidget#qt_scrollarea_viewport { background-color: @SURFACE@; }
*[designSystemClass="commonWidget::Z_ScrollArea"]:disabled QWidget#qt_scrollarea_viewport { background-color: @DISABLED@; }
*[designSystemClass="commonWidget::Z_ScrollAreaContent"] {
    background-color: @SURFACE@;
}
*[designSystemClass="commonWidget::Z_ScrollAreaContent"]:disabled {
    background-color: @DISABLED@;
}
*[designSystemClass="commonWidget::Z_ScrollAreaContentSkeleton"] {
    background-color: @DISABLED@;
    border: 0;
    border-radius: 4px;
}
*[designSystemClass="commonWidget::Z_ScrollAreaContentSkeleton"]:disabled {
    background-color: @DISABLED_BORDER@;
}
