/* Z_Frame <- QFrame; compiled from the active Token profile. */
*[designSystemClass="commonWidget::Z_Frame"] {
    color: @FOREGROUND@;
    background-color: @SURFACE@;
    font-size: @FONT_SIZE@px;
}
*[designSystemClass="commonWidget::Z_Frame"]:disabled {
    color: @DISABLED_TEXT@;
    background-color: @DISABLED@;
    border-color: @DISABLED_BORDER@;
}
