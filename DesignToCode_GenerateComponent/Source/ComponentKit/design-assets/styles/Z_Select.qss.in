/* Select-specific structure. Values are supplied by the shared field Token catalog. */
QFrame#POPUP { background:{{BACKGROUND}};border:{{BORDER_WIDTH}}px solid {{BORDER}};border-radius:{{POPUP_RADIUS}}px; }
QListView#LIST { background:{{BACKGROUND}};border:0;color:{{TEXT}};font-family:"{{FAMILY}}";font-size:{{FONT}}px; }
QListView#LIST::item:selected { background:{{OPTION_SELECTED}};color:{{TEXT}}; }
QListView#LIST::item:hover { background:{{OPTION_HOVER}}; }
QListView#LIST::item:disabled { color:{{DISABLED_TEXT}}; }
QLineEdit#SEARCH { min-height:{{ACTION_SIZE}}px;font-family:"{{FAMILY}}";font-size:{{FONT}}px; }
QFrame#TAG { background:{{TAG_BACKGROUND}};border:0;border-radius:{{ACTION_RADIUS}}px; }
QLabel#TAG_LABEL, QLabel#TAG_OVERFLOW { color:{{TEXT}};font-family:"{{FAMILY}}";font-size:{{FONT}}px; }
QLabel#TAG_LABEL:disabled, QLabel#TAG_OVERFLOW:disabled { color:{{DISABLED_TEXT}}; }
