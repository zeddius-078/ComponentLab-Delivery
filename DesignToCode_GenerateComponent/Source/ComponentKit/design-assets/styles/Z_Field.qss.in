/* GENERATED. FieldChrome owns the frame; native editors retain editing/IME behavior. */
QFrame[fieldPart="CONTROL"] { {{FACE}} }
QLineEdit[fieldPart="EDITOR"], QPlainTextEdit[fieldPart="EDITOR"] {
    background:transparent; border:0; padding:0; min-height:0; color:{{TEXT}};
    font-family:"{{FAMILY}}"; font-size:{{FONT}}px;
    selection-background-color:{{ACCENT}}; selection-color:{{ON_ACCENT}};
}
QLabel[fieldPart="PREFIX"], QLabel[fieldPart="SUFFIX"] {
    background:transparent; border:0; padding:0; color:{{TEXT}};
    font-family:"{{FAMILY}}"; font-size:{{FONT}}px;
}
QLabel[fieldPart="LABEL"] { font-family:"{{FAMILY}}";font-size:{{LABEL_FONT}}px;color:{{TEXT}}; }
QLabel[fieldPart="HINT"], QLabel[fieldPart="COUNT"] { font-family:"{{FAMILY}}";font-size:{{HINT_FONT}}px;color:{{MUTED}}; }
QLabel[fieldPart="COUNT"][countExceeded="true"] { color:{{ERROR}}; }
commonWidget--Z_PushButton[fieldPart="ACTION"] {
    background:transparent; border:0; padding:0; border-radius:{{ACTION_RADIUS}}px;
}
commonWidget--Z_PushButton[fieldPart="ACTION"]:enabled:hover {
    background:{{OPTION_HOVER}};
}
commonWidget--Z_PushButton[fieldPart="ACTION"]:enabled:pressed,
commonWidget--Z_PushButton[fieldPart="ACTION"]:enabled:focus[focusIndicatorVisible="true"] {
    background:{{OPTION_SELECTED}}; border:0;
}
