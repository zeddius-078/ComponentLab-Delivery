{
  "schemaVersion": 1,
  "id": "component-lab-qt-mapping-v1",
  "status": "ADAPTED_LOCAL_CONTRACT",
  "designBinding": "PENDING_DESIGN_COMPONENT_IDENTITIES",
  "components": {
    "Button": {
      "factory": "button",
      "class": "commonWidget::Z_PushButton",
      "header": "runtime/component/Z_PushButton.h",
      "implementation": "runtime/component/Z_PushButton.cpp",
      "tokenContract": "design-assets/tokens/button-contract.json",
      "style": "generated/button/<profile>/Z_PushButton.qss",
      "properties": {
        "text": {
          "type": "string",
          "default": "Button",
          "api": "setText"
        },
        "type": {
          "type": "enum",
          "values": [
            "primary",
            "default",
            "dashed",
            "text",
            "link"
          ],
          "default": "default",
          "api": "setType"
        },
        "controlSize": {
          "type": "enum",
          "values": [
            "xs",
            "sm",
            "md",
            "lg"
          ],
          "default": "sm",
          "api": "setSize",
          "qtValues": [
            "XS",
            "S",
            "M",
            "L"
          ],
          "tokenValues": {
            "xs": "sm",
            "sm": "sm",
            "md": "md",
            "lg": "lg"
          }
        },
        "danger": {
          "type": "bool",
          "default": false,
          "api": "setDanger"
        },
        "ghost": {
          "type": "bool",
          "default": false,
          "api": "setGhost"
        },
        "loading": {
          "type": "bool",
          "default": false,
          "api": "setLoading"
        },
        "disabled": {
          "type": "bool",
          "default": false,
          "api": "setEnabled(!value)"
        },
        "appearance": {
          "type": "buttonMaterial",
          "default": "solid",
          "api": "ButtonAppearanceAdapter.setAppearance"
        },
        "leadingIcon": {
          "type": "asset",
          "default": "",
          "api": "setLeadingIconSource"
        },
        "trailingIcon": {
          "type": "asset",
          "default": "",
          "api": "setTrailingIconSource"
        },
        "accessibleName": {
          "type": "string",
          "default": "",
          "api": "setAccessibleName"
        }
      },
      "tokenRefs": [
        "component.basic.button.size.md.height",
        "base.stoken.typography.font-size.label.default"
      ],
      "tokenRefOverrides": {
        "xs": {
          "component.basic.button.size.md.height": "semantic.dimension.control.height-xs"
        }
      }
    },
    "IconButton": {
      "extends": "Button",
      "iconOnly": true
    },
