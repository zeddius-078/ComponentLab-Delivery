/* Z_DoubleSpinBox <- QDoubleSpinBox; compiled from the active Token profile. */
*[designSystemClass="commonWidget::Z_DoubleSpinBox"] {
    color: #191919;
    background-color: #FFFFFF;
    font-size: 14px;
}
*[designSystemClass="commonWidget::Z_DoubleSpinBox"]:disabled {
    color: #BBBBBB;
    background-color: #EEEEEE;
    border-color: #8A8A8A;
}
*[designSystemClass="commonWidget::Z_DoubleSpinBox"] {
    min-height: 32px;
    border: 1px solid #A7A7A7;
    border-radius: 4px;
    padding-left: 8px;
    padding-right: 8px;
}
*[designSystemClass="commonWidget::Z_DoubleSpinBox"]:focus[focusIndicatorVisible="true"] { border-color: #6235F7; }
