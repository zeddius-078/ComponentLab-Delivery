/* Z_RadioButton <- QRadioButton; compiled from the active Token profile. */
*[designSystemClass="commonWidget::Z_RadioButton"] {
    color: #F3F3F3;
    background-color: #272727;
    font-size: 14px;
}
*[designSystemClass="commonWidget::Z_RadioButton"]:disabled {
    color: #8A8A8A;
    background-color: #303030;
    border-color: #8A8A8A;
}
*[designSystemClass="commonWidget::Z_RadioButton"] {
    min-height: 32px;
    border: 1px solid #676767;
    border-radius: 4px;
    padding: 0 12px;
}
*[designSystemClass="commonWidget::Z_RadioButton"]:hover { background-color: #F3EFFF; }
*[designSystemClass="commonWidget::Z_RadioButton"]:pressed { border-color: #6235F7; }
