/* Z_CommandLinkButton <- QCommandLinkButton; compiled from the active Token profile. */
*[designSystemClass="commonWidget::Z_CommandLinkButton"][designSystemStyleOwner="tokens"] {
    color: #191919;
    background-color: #FFFFFF;
    font-size: 14px;
}
*[designSystemClass="commonWidget::Z_CommandLinkButton"][designSystemStyleOwner="tokens"]:disabled {
    color: #BBBBBB;
    background-color: #EEEEEE;
    border-color: #8A8A8A;
}
*[designSystemClass="commonWidget::Z_CommandLinkButton"][designSystemStyleOwner="tokens"] {
    min-height: 32px;
    border: 1px solid #A7A7A7;
    border-radius: 4px;
    padding: 0 12px;
}
*[designSystemClass="commonWidget::Z_CommandLinkButton"][designSystemStyleOwner="tokens"]:hover { background-color: #F3EFFF; }
*[designSystemClass="commonWidget::Z_CommandLinkButton"][designSystemStyleOwner="tokens"]:pressed { border-color: #6235F7; }
