/* Z_StatusBar <- QStatusBar; compiled from the active Token profile. */
*[designSystemClass="commonWidget::Z_StatusBar"] {
    color: #191919;
    background-color: #FFFFFF;
    font-size: 18px;
}
*[designSystemClass="commonWidget::Z_StatusBar"]:disabled {
    color: #BBBBBB;
    background-color: #EEEEEE;
    border-color: #8A8A8A;
}
