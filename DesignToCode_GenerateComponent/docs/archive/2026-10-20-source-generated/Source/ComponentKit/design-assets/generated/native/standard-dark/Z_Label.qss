/* Z_Label <- QLabel; compiled from the active Token profile. */
*[designSystemClass="commonWidget::Z_Label"] {
    color: #F3F3F3;
    background-color: #272727;
    font-size: 14px;
}
*[designSystemClass="commonWidget::Z_Label"]:disabled {
    color: #8A8A8A;
    background-color: #303030;
    border-color: #8A8A8A;
}
*[designSystemClass="commonWidget::Z_Label"] { background: transparent; border: none; }
