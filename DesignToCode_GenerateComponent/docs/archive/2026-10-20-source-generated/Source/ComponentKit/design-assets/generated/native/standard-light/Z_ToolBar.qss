/* Z_ToolBar <- QToolBar; compiled from the active Token profile. */
*[designSystemClass="commonWidget::Z_ToolBar"] {
    color: #191919;
    background-color: #FFFFFF;
    font-size: 14px;
}
*[designSystemClass="commonWidget::Z_ToolBar"]:disabled {
    color: #BBBBBB;
    background-color: #EEEEEE;
    border-color: #8A8A8A;
}
