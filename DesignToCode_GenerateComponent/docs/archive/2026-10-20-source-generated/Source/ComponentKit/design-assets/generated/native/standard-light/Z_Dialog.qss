/* Z_Dialog <- QDialog; compiled from the active Token profile. */
*[designSystemClass="commonWidget::Z_Dialog"] {
    color: #191919;
    background-color: #FFFFFF;
    font-size: 14px;
}
*[designSystemClass="commonWidget::Z_Dialog"]:disabled {
    color: #BBBBBB;
    background-color: #EEEEEE;
    border-color: #8A8A8A;
}
