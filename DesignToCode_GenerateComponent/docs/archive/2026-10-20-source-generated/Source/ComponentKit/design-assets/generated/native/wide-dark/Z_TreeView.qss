/* Z_TreeView <- QTreeView; compiled from the active Token profile. */
*[designSystemClass="commonWidget::Z_TreeView"] {
    color: #F3F3F3;
    background-color: #272727;
    font-size: 18px;
}
*[designSystemClass="commonWidget::Z_TreeView"]:disabled {
    color: #8A8A8A;
    background-color: #303030;
    border-color: #8A8A8A;
}
*[designSystemClass="commonWidget::Z_TreeView"] {
    border: 1px solid #676767;
    border-radius: 4px;
}
