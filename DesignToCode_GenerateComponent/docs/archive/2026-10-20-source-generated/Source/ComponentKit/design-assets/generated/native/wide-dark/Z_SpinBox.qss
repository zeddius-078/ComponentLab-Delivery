/* Z_SpinBox <- QSpinBox; compiled from the active Token profile. */
*[designSystemClass="commonWidget::Z_SpinBox"] {
    color: #F3F3F3;
    background-color: #272727;
    font-size: 18px;
}
*[designSystemClass="commonWidget::Z_SpinBox"]:disabled {
    color: #8A8A8A;
    background-color: #303030;
    border-color: #8A8A8A;
}
*[designSystemClass="commonWidget::Z_SpinBox"] {
    min-height: 40px;
    border: 1px solid #676767;
    border-radius: 4px;
    padding-left: 8px;
    padding-right: 8px;
}
*[designSystemClass="commonWidget::Z_SpinBox"]:focus[focusIndicatorVisible="true"] { border-color: #6235F7; }
