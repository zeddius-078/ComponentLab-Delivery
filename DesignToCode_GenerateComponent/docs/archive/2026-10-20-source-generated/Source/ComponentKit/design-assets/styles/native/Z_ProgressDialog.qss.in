/* Z_ProgressDialog <- QProgressDialog; compiled from the active Token profile. */
*[designSystemClass="commonWidget::Z_ProgressDialog"] {
    color: @FOREGROUND@;
    background-color: @SURFACE@;
    font-size: @FONT_SIZE@px;
}
*[designSystemClass="commonWidget::Z_ProgressDialog"]:disabled {
    color: @DISABLED_TEXT@;
    background-color: @DISABLED@;
    border-color: @DISABLED_BORDER@;
}
