# GenerateLayout consumes a published binary SDK. It has no component or Token build fallback.
if(NOT GENERATED_COMPONENT_SDK_ROOT)
    message(FATAL_ERROR "SDK_ROOT_REQUIRED: pass the resolved GENERATED_COMPONENT_SDK_ROOT explicitly.")
endif()
get_filename_component(GENERATED_COMPONENT_SDK_ROOT "${GENERATED_COMPONENT_SDK_ROOT}" ABSOLUTE)
if(DEFINED D2C_CONFIGURED_SDK_ROOT AND NOT D2C_CONFIGURED_SDK_ROOT STREQUAL GENERATED_COMPONENT_SDK_ROOT)
    message(FATAL_ERROR "SDK_CACHE_CONFLICT: use a fresh build directory when changing GENERATED_COMPONENT_SDK_ROOT.")
endif()
if(DEFINED GeneratedComponentSDK_DIR)
    get_filename_component(_CACHED_SDK_CONFIG "${GeneratedComponentSDK_DIR}" ABSOLUTE)
    if(NOT _CACHED_SDK_CONFIG STREQUAL "${GENERATED_COMPONENT_SDK_ROOT}/cmake")
        message(FATAL_ERROR "SDK_CACHE_CONFLICT: cached GeneratedComponentSDK_DIR points to a different publication.")
    endif()
endif()
set(D2C_CONFIGURED_SDK_ROOT "${GENERATED_COMPONENT_SDK_ROOT}" CACHE INTERNAL "SDK publication used by this build tree")
set(_GENERATED_COMPONENT_CONFIG "${GENERATED_COMPONENT_SDK_ROOT}/cmake/GeneratedComponentSDKConfig.cmake")
if(NOT EXISTS "${_GENERATED_COMPONENT_CONFIG}")
    message(FATAL_ERROR "Authoritative GeneratedComponentSDK is missing. Publish it from DesignToCode_GenerateComponent or set GENERATED_COMPONENT_SDK_ROOT.")
endif()
find_package(GeneratedComponentSDK 1.0 CONFIG REQUIRED
    PATHS "${GENERATED_COMPONENT_SDK_ROOT}/cmake" NO_DEFAULT_PATH)
